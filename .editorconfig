root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml,razor,js,css,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = when_multiline:suggestion
dotnet_sort_system_directives_first = true

# EF Core migrations are generated by `dotnet ef migrations add` (CRLF, BOM, block-scoped namespace on Windows)
# and are never edited by hand - they are not held to the hand-written style, so `dotnet format
# --verify-no-changes` stays a meaningful gate for the rest of the code.
[**/Data/Migrations/*.cs]
generated_code = true
end_of_line = unset
charset = unset
csharp_style_namespace_declarations = block_scoped:silent
