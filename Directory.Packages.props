<Project>
  <!-- Central Package Management: every NuGet version lives here. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="MudBlazor" Version="9.14.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.Abstractions" Version="10.0.15" />
    <!-- Identity's EF Core store (IdentityDbContext, UserStore); Identity.Core/Cookies/Authorization itself ships
         in the ASP.NET Core shared framework already referenced by Lotse.Web (Microsoft.NET.Sdk.Web) - no separate
         package needed for those. -->
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.15" />
    <PackageVersion Include="Anthropic" Version="13.13.0" />
    <!-- tools/Lotse.Mcp: the official C# SDK of the Model Context Protocol, and the generic host it runs in. -->
    <PackageVersion Include="ModelContextProtocol" Version="2.4.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="bunit" Version="2.15.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.65.1" />
    <PackageVersion Include="Deque.AxeCore.Playwright" Version="4.14.0" />
  </ItemGroup>
</Project>
