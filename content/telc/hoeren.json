            { "text": "Den Umbau hat vor allem eine Baufirma gemacht.", "true": false, "explanation": "„zum größten Teil selbst gemacht, mit Freunden und Nachbarn“." },
            { "text": "Im Coworking-Space arbeiten nur Menschen aus der IT-Branche.", "true": false, "explanation": "Auch eine Grafikerin, ein Steuerberater, eine Lehrerin." },
            { "text": "Man kann einen Arbeitsplatz auch für einzelne Tage buchen.", "true": true },
            { "text": "Herr Brandl lebt inzwischen von den Einnahmen des Coworking-Space.", "true": false, "explanation": "Er verdient sein Geld „weiterhin als Softwareentwickler“." },
            { "text": "In den Räumen finden auch Veranstaltungen für das Dorf statt.", "true": true },
            { "text": "Wegen des Coworking-Space sind Familien ins Dorf gezogen.", "true": true },
            { "text": "Herr Brandl empfiehlt, gleich mit einem großen Projekt zu starten.", "true": false, "explanation": "„man sollte klein anfangen“." }
          ]
