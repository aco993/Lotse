@page "/Account/Login"
@layout AccountLayout
@attribute [AllowAnonymous]

@using Lotse.Infrastructure.Data
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager

@* Static SSR by design – see Register.razor's doc comment for why. *@

<PageTitle>Anmelden – Lotse</PageTitle>

<h1>Willkommen zurück</h1>
<p class="acct-sub">Melde dich an – dein Lernstand wartet.</p>

@if (_errorMessage is not null)
{
    <AcctAlert Kind="error">@_errorMessage</AcctAlert>
}
@if (StatusMessage is { } status)
{
    <AcctAlert Kind="success">@status</AcctAlert>
}

<EditForm Model="Input" method="post" OnValidSubmit="LoginUserAsync" FormName="login">
    <DataAnnotationsValidator />
    <div class="acct-field">
        <label class="acct-label" for="email">E-Mail</label>
        <InputText id="email" type="email" @bind-Value="Input.Email" autocomplete="username" inputmode="email" autocapitalize="none" spellcheck="false" placeholder="name@beispiel.de" autofocus />
        <ValidationMessage For="() => Input.Email" class="acct-error" />
    </div>
    <div class="acct-field">
        <label class="acct-label" for="password"><span>Passwort</span><a href="Account/ForgotPassword">Passwort vergessen?</a></label>
        <div class="acct-pw">
            <InputText id="password" type="password" @bind-Value="Input.Password" autocomplete="current-password" />
            <AcctPwToggle Target="password" />
        </div>
        <ValidationMessage For="() => Input.Password" class="acct-error" />
    </div>
    <label class="acct-check" for="remember">
        <InputCheckbox id="remember" @bind-Value="Input.RememberMe" />
        <span>Angemeldet bleiben</span>
    </label>
    <button type="submit" class="acct-btn">Anmelden</button>
</EditForm>

<div class="acct-alt">Neu hier? <a href="@RegisterUrl">Konto erstellen</a></div>

@code {
    private string? _errorMessage;

#pragma warning disable BL0008 // Safe: this EditForm always posts back to this same page with every field present.
    [SupplyParameterFromForm] private InputModel Input { get; set; } = new();
#pragma warning restore BL0008
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    private string RegisterUrl => "Account/Register" + (string.IsNullOrEmpty(ReturnUrl) ? "" : $"?returnUrl={Uri.EscapeDataString(ReturnUrl)}");

    private string? StatusMessage
    {
        get
        {
            if (!HttpContext.Request.Cookies.TryGetValue(IdentityRedirectManager.StatusCookieName, out var message)) return null;
            HttpContext.Response.Cookies.Delete(IdentityRedirectManager.StatusCookieName);
            return message;
        }
    }

    public async Task LoginUserAsync()
    {
        var result = await SignInManager.PasswordSignInAsync(Input.Email, Input.Password, Input.RememberMe, lockoutOnFailure: false);
        if (result.Succeeded) RedirectManager.RedirectTo(ReturnUrl ?? "");
        else _errorMessage = "Anmeldung fehlgeschlagen – E-Mail oder Passwort stimmt nicht.";
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Bitte E-Mail eingeben.")]
        [EmailAddress(ErrorMessage = "Das sieht nicht nach einer E-Mail-Adresse aus.")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Bitte Passwort eingeben.")]
        public string Password { get; set; } = "";

        public bool RememberMe { get; set; }
    }
}
