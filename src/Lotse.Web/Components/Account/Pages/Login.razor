@page "/Account/Login"
@layout AccountLayout
@attribute [AllowAnonymous]

@using Lotse.Infrastructure.Data
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager

@* Static SSR by design – see Register.razor's doc comment for why. Two ways in: password, or a passkey (WebAuthn)
   via PasskeySubmit, which posts the credential back through this same form as Input.Passkey. *@

<PageTitle>Anmelden – Lotse</PageTitle>

<h1>Willkommen zurück</h1>
<p class="acct-sub">Melde dich an – dein Lernstand wartet.</p>

@if (_errorMessage is not null)
{
    <AcctAlert Kind="error">@_errorMessage</AcctAlert>
}
@if (_statusMessage is not null)
{
    <AcctAlert Kind="success">@_statusMessage</AcctAlert>
}

<EditForm EditContext="_editContext" method="post" OnSubmit="LoginUserAsync" FormName="login">
    <DataAnnotationsValidator />
    <div class="acct-field">
        <label class="acct-label" for="email">E-Mail</label>
        <InputText id="email" type="email" @bind-Value="Input.Email" autocomplete="username webauthn" inputmode="email" autocapitalize="none" spellcheck="false" placeholder="name@beispiel.de" autofocus />
        <ValidationMessage For="() => Input.Email" class="acct-error" />
    </div>
    <div class="acct-field">
        <label class="acct-label" for="password"><span>Passwort</span><a href="Account/ForgotPassword">Passwort vergessen?</a></label>
        <div class="acct-pw">
            <InputText id="password" type="password" @bind-Value="Input.Password" autocomplete="current-password" />
            <AcctPwToggle Target="password" />
        </div>
        <ValidationMessage For="() => Input.Password" class="acct-error" />
    </div>
    <label class="acct-check" for="remember">
        <InputCheckbox id="remember" @bind-Value="Input.RememberMe" />
        <span>Angemeldet bleiben</span>
    </label>
    <button type="submit" class="acct-btn">Anmelden</button>
    <div class="acct-divider">oder</div>
    <PasskeySubmit Operation="PasskeyOperation.Request" Name="Input.Passkey" EmailName="Input.Email" class="acct-btn secondary">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 11V7a5 5 0 0 1 10 0v4"/><rect x="4" y="11" width="16" height="10" rx="2"/><circle cx="12" cy="16" r="1.5"/></svg>
        Mit Passkey anmelden
    </PasskeySubmit>
</EditForm>

<div class="acct-alt">Neu hier? <a href="@RegisterUrl">Konto erstellen</a></div>

@code {
    private string? _errorMessage;
    private string? _statusMessage;
    private EditContext _editContext = default!;

#pragma warning disable BL0008 // Safe: this EditForm always posts back to this same page with every field present.
    [SupplyParameterFromForm] private InputModel Input { get; set; } = new();
#pragma warning restore BL0008
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    private string RegisterUrl => "Account/Register" + (string.IsNullOrEmpty(ReturnUrl) ? "" : $"?returnUrl={Uri.EscapeDataString(ReturnUrl)}");

    protected override void OnInitialized()
    {
        _editContext = new EditContext(Input);
        // One-shot status from a redirect (e.g. "account not found"), same pattern as Manage/ChangePassword.
        if (HttpContext.Request.Cookies.TryGetValue(IdentityRedirectManager.StatusCookieName, out var message))
        {
            HttpContext.Response.Cookies.Delete(IdentityRedirectManager.StatusCookieName);
            _statusMessage = message;
        }
    }

    public async Task LoginUserAsync()
    {
        if (!string.IsNullOrEmpty(Input.Passkey?.Error))
        {
            _errorMessage = $"Passkey: {Input.Passkey.Error}";
            return;
        }

        SignInResult result;
        if (!string.IsNullOrEmpty(Input.Passkey?.CredentialJson))
        {
            // Passkey sign-in carries no password, so the DataAnnotations on the password field must not run.
            result = await SignInManager.PasskeySignInAsync(Input.Passkey.CredentialJson);
        }
        else
        {
            if (!_editContext.Validate()) return;
            // lockoutOnFailure: true - five wrong passwords lock the account for five minutes (IdentityOptions.Lockout
            // defaults), otherwise this form would allow unlimited guessing against any registered address.
            result = await SignInManager.PasswordSignInAsync(Input.Email, Input.Password, Input.RememberMe, lockoutOnFailure: true);
        }

        if (result.Succeeded) RedirectManager.RedirectTo(ReturnUrl ?? "");
        else if (result.IsLockedOut) _errorMessage = "Zu viele Fehlversuche – dieses Konto ist für fünf Minuten gesperrt.";
        else _errorMessage = "Anmeldung fehlgeschlagen – E-Mail oder Passwort stimmt nicht.";
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Bitte E-Mail eingeben.")]
        [EmailAddress(ErrorMessage = "Das sieht nicht nach einer E-Mail-Adresse aus.")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Bitte Passwort eingeben.")]
        public string Password { get; set; } = "";

        public bool RememberMe { get; set; }

        public PasskeyInputModel? Passkey { get; set; }
    }
}
