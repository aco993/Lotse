@page "/Account/Manage/ChangePassword"
@layout AccountLayout
@attribute [Authorize]

@using Lotse.Infrastructure.Data
@inject IdentityUserAccessor UserAccessor
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<ChangePassword> Logger

@* Static SSR – RefreshSignInAsync below needs a real HTTP response, same reasoning as Register.razor. *@

<PageTitle>Passwort ändern – Lotse</PageTitle>

<h1 class="account-title">Passwort ändern</h1>

@if (_message is not null)
{
    <div class="account-alert @(_success ? "success" : "error")">@_message</div>
}

<EditForm Model="Input" method="post" OnValidSubmit="OnValidSubmitAsync" FormName="change-password">
    <DataAnnotationsValidator />
    <div class="account-field">
        <label for="current">Aktuelles Passwort</label>
        <InputText id="current" type="password" @bind-Value="Input.OldPassword" autocomplete="current-password" />
        <ValidationMessage For="() => Input.OldPassword" class="account-error" />
    </div>
    <div class="account-field">
        <label for="new">Neues Passwort</label>
        <InputText id="new" type="password" @bind-Value="Input.NewPassword" autocomplete="new-password" placeholder="mindestens 8 Zeichen" />
        <ValidationMessage For="() => Input.NewPassword" class="account-error" />
    </div>
    <div class="account-field">
        <label for="confirm">Bestätigen</label>
        <InputText id="confirm" type="password" @bind-Value="Input.ConfirmPassword" autocomplete="new-password" />
        <ValidationMessage For="() => Input.ConfirmPassword" class="account-error" />
    </div>
    <button type="submit" class="account-submit">Ändern</button>
</EditForm>

<div class="account-links"><a href="Account/Manage">← Zurück zum Konto</a></div>

@code {
    private string? _message;
    private bool _success;

    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
#pragma warning disable BL0008 // Safe: this EditForm always posts back to this same page with every field present.
    [SupplyParameterFromForm] private InputModel Input { get; set; } = new();
#pragma warning restore BL0008

    protected override void OnInitialized()
    {
        if (HttpContext.Request.Cookies.TryGetValue(IdentityRedirectManager.StatusCookieName, out var message))
        {
            HttpContext.Response.Cookies.Delete(IdentityRedirectManager.StatusCookieName);
            _message = message;
            _success = true;
        }
    }

    public async Task OnValidSubmitAsync()
    {
        var user = await UserAccessor.GetRequiredUserAsync(HttpContext);
        if (user is null) return;
        var result = await UserManager.ChangePasswordAsync(user, Input.OldPassword, Input.NewPassword);
        if (!result.Succeeded)
        {
            _message = string.Join(" ", result.Errors.Select(e => e.Description));
            _success = false;
            return;
        }
        await SignInManager.RefreshSignInAsync(user);
        Logger.LogInformation("Passwort geändert.");
        RedirectManager.RedirectToCurrentPageWithStatus("Dein Passwort wurde geändert.", HttpContext);
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Erforderlich.")]
        public string OldPassword { get; set; } = "";

        [Required(ErrorMessage = "Erforderlich.")]
        [StringLength(100, ErrorMessage = "Das Passwort muss mindestens {2} Zeichen haben.", MinimumLength = 8)]
        public string NewPassword { get; set; } = "";

        [Required(ErrorMessage = "Bitte bestätigen.")]
        [Compare(nameof(NewPassword), ErrorMessage = "Die Passwörter stimmen nicht überein.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
