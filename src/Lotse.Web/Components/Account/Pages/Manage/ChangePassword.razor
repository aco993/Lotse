@page "/Account/Manage/ChangePassword"
@layout AccountLayout
@attribute [Authorize]

@using Lotse.Infrastructure.Data
@inject IdentityUserAccessor UserAccessor
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<ChangePassword> Logger

@* Static SSR – RefreshSignInAsync below needs a real HTTP response, same reasoning as Register.razor. *@

<PageTitle>Passwort ändern – Lotse</PageTitle>

<h1>Passwort ändern</h1>
<p class="acct-sub">Zuerst das aktuelle, dann zweimal das neue Passwort.</p>

@if (_message is not null)
{
    <AcctAlert Kind="@(_success ? "success" : "error")">@_message</AcctAlert>
}

<EditForm Model="Input" method="post" OnValidSubmit="OnValidSubmitAsync" FormName="change-password">
    <DataAnnotationsValidator />
    <div class="acct-field">
        <label class="acct-label" for="current">Aktuelles Passwort</label>
        <div class="acct-pw">
            <InputText id="current" type="password" @bind-Value="Input.OldPassword" autocomplete="current-password" autofocus />
            <AcctPwToggle Target="current" />
        </div>
        <ValidationMessage For="() => Input.OldPassword" class="acct-error" />
    </div>
    <div class="acct-field">
        <label class="acct-label" for="new">Neues Passwort</label>
        <div class="acct-pw">
            <InputText id="new" type="password" @bind-Value="Input.NewPassword" autocomplete="new-password" />
            <AcctPwToggle Target="new" />
        </div>
        <ValidationMessage For="() => Input.NewPassword" class="acct-error" />
        <div class="acct-hint">Mindestens 8 Zeichen.</div>
    </div>
    <div class="acct-field">
        <label class="acct-label" for="confirm">Neues Passwort wiederholen</label>
        <div class="acct-pw">
            <InputText id="confirm" type="password" @bind-Value="Input.ConfirmPassword" autocomplete="new-password" />
            <AcctPwToggle Target="confirm" />
        </div>
        <ValidationMessage For="() => Input.ConfirmPassword" class="acct-error" />
    </div>
    <button type="submit" class="acct-btn">Passwort ändern</button>
</EditForm>

<div class="acct-alt"><a href="Account/Manage">← Zurück zum Konto</a></div>

@code {
    private string? _message;
    private bool _success;

    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
#pragma warning disable BL0008 // Safe: this EditForm always posts back to this same page with every field present.
    [SupplyParameterFromForm] private InputModel Input { get; set; } = new();
#pragma warning restore BL0008

    protected override void OnInitialized()
    {
        if (HttpContext.Request.Cookies.TryGetValue(IdentityRedirectManager.StatusCookieName, out var message))
        {
            HttpContext.Response.Cookies.Delete(IdentityRedirectManager.StatusCookieName);
            _message = message;
            _success = true;
        }
    }

    public async Task OnValidSubmitAsync()
    {
        var user = await UserAccessor.GetRequiredUserAsync(HttpContext);
        if (user is null) return;
        var result = await UserManager.ChangePasswordAsync(user, Input.OldPassword, Input.NewPassword);
        if (!result.Succeeded)
        {
            _message = string.Join(" ", result.Errors.Select(e => e.Description));
            _success = false;
            return;
        }
        await SignInManager.RefreshSignInAsync(user);
        Logger.LogInformation("Passwort geändert.");
        RedirectManager.RedirectToCurrentPageWithStatus("Dein Passwort wurde geändert.", HttpContext);
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Bitte aktuelles Passwort eingeben.")]
        public string OldPassword { get; set; } = "";

        [Required(ErrorMessage = "Bitte neues Passwort wählen.")]
        [StringLength(100, ErrorMessage = "Mindestens {2} Zeichen.", MinimumLength = 8)]
        public string NewPassword { get; set; } = "";

        [Required(ErrorMessage = "Bitte neues Passwort wiederholen.")]
        [Compare(nameof(NewPassword), ErrorMessage = "Die beiden Passwörter stimmen nicht überein.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
