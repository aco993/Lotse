@page "/Account/Manage"
@layout AccountLayout
@attribute [Authorize]

@using Lotse.Infrastructure.Data
@inject IdentityUserAccessor UserAccessor
@inject UserManager<ApplicationUser> UserManager

@* Static SSR, same reasoning as Register.razor: kept in the small Account shell (not the interactive MainLayout)
   so ChangePassword's re-sign-in on the linked page can set the auth cookie from a real HTTP response. *@

<PageTitle>Konto – Lotse</PageTitle>

<h1>Dein Konto</h1>
<p class="acct-sub">Alles, was du hier lernst, gehört nur zu diesem Konto.</p>

<div class="acct-kv"><b>E-Mail</b><span>@_email</span></div>
<div class="acct-kv"><b>Passwort</b><a href="Account/Manage/ChangePassword">Ändern</a></div>
<div class="acct-kv"><b>Passkeys</b><a href="Account/Manage/Passkeys">@(_passkeyCount == 0 ? "Einrichten" : $"{_passkeyCount} verwalten")</a></div>

<div class="acct-links">
    <a href="einstellungen">← Zurück zu den Einstellungen</a>
</div>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    private string? _email;
    private int _passkeyCount;

    protected override async Task OnInitializedAsync()
    {
        var user = await UserAccessor.GetRequiredUserAsync(HttpContext);
        if (user is null) return;
        _email = await UserManager.GetEmailAsync(user);
        _passkeyCount = (await UserManager.GetPasskeysAsync(user)).Count;
    }
}
