@page "/Account/Register"
@layout AccountLayout
@attribute [AllowAnonymous]

@using Lotse.Infrastructure.Data
@inject UserManager<ApplicationUser> UserManager
@inject IUserStore<ApplicationUser> UserStore
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager

@* Static SSR by design (no @@rendermode line anywhere on this route): setting the auth cookie via
   SignInManager.SignInAsync needs a real HTTP response, which a live Blazor Server circuit no longer has. The rest
   of Lotse renders interactively; App.razor decides per request (path under /Account → static, else
   InteractiveServer) and applies that on <Routes> - see App.razor's own comment for why it can only sit there. *@

<PageTitle>Registrieren – Lotse</PageTitle>

<h1>Konto erstellen</h1>
<p class="acct-sub">Dein eigener Lernstand – komplett getrennt von jedem anderen Konto auf diesem Rechner.</p>

@if (_identityErrors is { } errors)
{
    <AcctAlert Kind="error">
        @foreach (var error in errors) { <div>@error</div> }
    </AcctAlert>
}

<EditForm Model="Input" method="post" OnValidSubmit="RegisterUserAsync" FormName="register">
    <DataAnnotationsValidator />
    <div class="acct-field">
        <label class="acct-label" for="email">E-Mail</label>
        <InputText id="email" type="email" @bind-Value="Input.Email" autocomplete="username" inputmode="email" autocapitalize="none" spellcheck="false" placeholder="name@beispiel.de" autofocus />
        <ValidationMessage For="() => Input.Email" class="acct-error" />
    </div>
    <div class="acct-field">
        <label class="acct-label" for="password">Passwort</label>
        <div class="acct-pw">
            <InputText id="password" type="password" @bind-Value="Input.Password" autocomplete="new-password" />
            <AcctPwToggle Target="password" />
        </div>
        <ValidationMessage For="() => Input.Password" class="acct-error" />
        <div class="acct-hint">Mindestens 8 Zeichen. Länge zählt mehr als Sonderzeichen – ein Satz, den nur du kennst, ist ideal.</div>
    </div>
    <div class="acct-field">
        <label class="acct-label" for="confirm">Passwort wiederholen</label>
        <div class="acct-pw">
            <InputText id="confirm" type="password" @bind-Value="Input.ConfirmPassword" autocomplete="new-password" />
            <AcctPwToggle Target="confirm" />
        </div>
        <ValidationMessage For="() => Input.ConfirmPassword" class="acct-error" />
    </div>
    <div class="acct-note">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m8.5 12.5 2.3 2.3L15.5 10"/></svg>
        <span>Keine Bestätigungs-Mail – du bist sofort drin.</span>
    </div>
    <button type="submit" class="acct-btn">Konto erstellen</button>
</EditForm>

<div class="acct-alt">Schon ein Konto? <a href="Account/Login">Anmelden</a></div>

@code {
    private IReadOnlyList<string>? _identityErrors;

#pragma warning disable BL0008 // Safe: this EditForm always posts back to this same page with every field present.
    [SupplyParameterFromForm] private InputModel Input { get; set; } = new();
#pragma warning restore BL0008
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    public async Task RegisterUserAsync()
    {
        var user = Activator.CreateInstance<ApplicationUser>();
        await UserStore.SetUserNameAsync(user, Input.Email, CancellationToken.None);
        var emailStore = (IUserEmailStore<ApplicationUser>)UserStore;
        await emailStore.SetEmailAsync(user, Input.Email, CancellationToken.None);
        var result = await UserManager.CreateAsync(user, Input.Password);

        if (!result.Succeeded)
        {
            // UserName == Email here, so a taken address comes back as DuplicateUserName AND DuplicateEmail with
            // the same German sentence - show it once.
            _identityErrors = result.Errors.Select(e => e.Description).Distinct().ToList();
            return;
        }

        // No email confirmation is configured (see IdentityNoOpEmailSender / README) – sign the learner in right away.
        await SignInManager.SignInAsync(user, isPersistent: false);
        RedirectManager.RedirectTo(ReturnUrl ?? "");
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Bitte E-Mail eingeben.")]
        [EmailAddress(ErrorMessage = "Das sieht nicht nach einer E-Mail-Adresse aus.")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Bitte Passwort wählen.")]
        [StringLength(100, ErrorMessage = "Mindestens {2} Zeichen.", MinimumLength = 8)]
        public string Password { get; set; } = "";

        [Required(ErrorMessage = "Bitte Passwort wiederholen.")]
        [Compare(nameof(Password), ErrorMessage = "Die beiden Passwörter stimmen nicht überein.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
