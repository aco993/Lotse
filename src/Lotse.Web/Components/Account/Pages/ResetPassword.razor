@page "/Account/ResetPassword"
@layout AccountLayout
@attribute [AllowAnonymous]

@using Lotse.Infrastructure.Data
@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager

@* Static SSR by design – see Register.razor's doc comment for why. *@

<PageTitle>Passwort zurücksetzen – Lotse</PageTitle>

<h1 class="account-title">Neues Passwort</h1>

@if (_identityErrors is { } errors)
{
    <div class="account-alert error">
        @foreach (var error in errors) { <div>@error</div> }
    </div>
}

<EditForm Model="Input" method="post" OnValidSubmit="OnValidSubmitAsync" FormName="reset-password">
    <DataAnnotationsValidator />
    <div class="account-field">
        <label for="email">E-Mail</label>
        <InputText id="email" @bind-Value="Input.Email" autocomplete="username" />
        <ValidationMessage For="() => Input.Email" class="account-error" />
    </div>
    <div class="account-field">
        <label for="password">Neues Passwort</label>
        <InputText id="password" type="password" @bind-Value="Input.Password" autocomplete="new-password" placeholder="mindestens 8 Zeichen" />
        <ValidationMessage For="() => Input.Password" class="account-error" />
    </div>
    <div class="account-field">
        <label for="confirm">Bestätigen</label>
        <InputText id="confirm" type="password" @bind-Value="Input.ConfirmPassword" autocomplete="new-password" />
        <ValidationMessage For="() => Input.ConfirmPassword" class="account-error" />
    </div>
    <button type="submit" class="account-submit">Passwort setzen</button>
</EditForm>

@code {
    private IReadOnlyList<string>? _identityErrors;

#pragma warning disable BL0008 // Safe: this EditForm always posts back to this same page with every field present.
    [SupplyParameterFromForm] private InputModel Input { get; set; } = new();
#pragma warning restore BL0008
    [SupplyParameterFromQuery] private string? Code { get; set; }

    protected override void OnInitialized()
    {
        if (Code is not null) Input.Code = System.Net.WebUtility.UrlDecode(Code);
    }

    public async Task OnValidSubmitAsync()
    {
        var user = await UserManager.FindByEmailAsync(Input.Email);
        if (user is null)
        {
            // Do not reveal whether the address is registered.
            RedirectManager.RedirectTo("Account/ResetPasswordConfirmation");
            return;
        }

        var result = await UserManager.ResetPasswordAsync(user, Input.Code, Input.Password);
        if (result.Succeeded)
        {
            RedirectManager.RedirectTo("Account/ResetPasswordConfirmation");
            return;
        }
        _identityErrors = result.Errors.Select(e => e.Description).ToList();
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "E-Mail erforderlich.")]
        [EmailAddress(ErrorMessage = "Ungültige E-Mail-Adresse.")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Passwort erforderlich.")]
        [StringLength(100, ErrorMessage = "Das Passwort muss mindestens {2} Zeichen haben.", MinimumLength = 8)]
        public string Password { get; set; } = "";

        [Required(ErrorMessage = "Bitte bestätigen.")]
        [Compare(nameof(Password), ErrorMessage = "Die Passwörter stimmen nicht überein.")]
        public string ConfirmPassword { get; set; } = "";

        public string Code { get; set; } = "";
    }
}
