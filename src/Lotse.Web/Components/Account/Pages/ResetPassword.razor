@page "/Account/ResetPassword"
@layout AccountLayout
@attribute [AllowAnonymous]

@using Lotse.Infrastructure.Data
@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager

@* Static SSR by design – see Register.razor's doc comment for why. *@

<PageTitle>Passwort zurücksetzen – Lotse</PageTitle>

<h1>Neues Passwort</h1>
<p class="acct-sub">Gib die E-Mail deines Kontos und ein neues Passwort ein.</p>

@if (_identityErrors is { } errors)
{
    <AcctAlert Kind="error">
        @foreach (var error in errors) { <div>@error</div> }
    </AcctAlert>
}

<EditForm Model="Input" method="post" OnValidSubmit="OnValidSubmitAsync" FormName="reset-password">
    <DataAnnotationsValidator />
    <div class="acct-field">
        <label class="acct-label" for="email">E-Mail</label>
        <InputText id="email" type="email" @bind-Value="Input.Email" autocomplete="username" inputmode="email" autocapitalize="none" spellcheck="false" placeholder="name@beispiel.de" autofocus />
        <ValidationMessage For="() => Input.Email" class="acct-error" />
    </div>
    <div class="acct-field">
        <label class="acct-label" for="password">Neues Passwort</label>
        <div class="acct-pw">
            <InputText id="password" type="password" @bind-Value="Input.Password" autocomplete="new-password" />
            <AcctPwToggle Target="password" />
        </div>
        <ValidationMessage For="() => Input.Password" class="acct-error" />
        <div class="acct-hint">Mindestens @PasswordRules.MinLength Zeichen.</div>
    </div>
    <div class="acct-field">
        <label class="acct-label" for="confirm">Passwort wiederholen</label>
        <div class="acct-pw">
            <InputText id="confirm" type="password" @bind-Value="Input.ConfirmPassword" autocomplete="new-password" />
            <AcctPwToggle Target="confirm" />
        </div>
        <ValidationMessage For="() => Input.ConfirmPassword" class="acct-error" />
    </div>
    <button type="submit" class="acct-btn">Passwort setzen</button>
</EditForm>

<div class="acct-alt"><a href="Account/Login">← Zurück zur Anmeldung</a></div>

@code {
    private IReadOnlyList<string>? _identityErrors;

#pragma warning disable BL0008 // Safe: this EditForm always posts back to this same page with every field present.
    [SupplyParameterFromForm] private InputModel Input { get; set; } = new();
#pragma warning restore BL0008
    [SupplyParameterFromQuery] private string? Code { get; set; }

    protected override void OnInitialized()
    {
        if (Code is not null) Input.Code = System.Net.WebUtility.UrlDecode(Code);
    }

    public async Task OnValidSubmitAsync()
    {
        var user = await UserManager.FindByEmailAsync(Input.Email);
        if (user is null)
        {
            // Do not reveal whether the address is registered.
            RedirectManager.RedirectTo("Account/ResetPasswordConfirmation");
            return;
        }

        var result = await UserManager.ResetPasswordAsync(user, Input.Code, Input.Password);
        if (result.Succeeded)
        {
            RedirectManager.RedirectTo("Account/ResetPasswordConfirmation");
            return;
        }
        _identityErrors = result.Errors.Select(e => e.Description).Distinct().ToList();
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Bitte E-Mail eingeben.")]
        [EmailAddress(ErrorMessage = "Das sieht nicht nach einer E-Mail-Adresse aus.")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Bitte Passwort wählen.")]
        [StringLength(100, ErrorMessage = "Mindestens {2} Zeichen.", MinimumLength = PasswordRules.MinLength)]
        public string Password { get; set; } = "";

        [Required(ErrorMessage = "Bitte Passwort wiederholen.")]
        [Compare(nameof(Password), ErrorMessage = "Die beiden Passwörter stimmen nicht überein.")]
        public string ConfirmPassword { get; set; } = "";

        public string Code { get; set; } = "";
    }
}
