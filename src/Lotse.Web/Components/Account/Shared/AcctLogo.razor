@* The favicon mark, inline so it renders without a network request and can be sized/coloured per use. *@
<svg class="acct-logo" width="@Size" height="@Size" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
    <rect width="64" height="64" rx="14" fill="@Background" />
    <path d="M32 10 L38 28 L32 24 L26 28 Z" fill="#fff" />
    <circle cx="32" cy="36" r="14" fill="none" stroke="#fff" stroke-width="4" />
    <path d="M32 36 L44 30" stroke="#E07A1F" stroke-width="4" stroke-linecap="round" />
    <circle cx="32" cy="36" r="3" fill="#E07A1F" />
</svg>

@code {
    [Parameter] public int Size { get; set; } = 32;
    /// <summary>Tile colour; on the dark brand panel a slightly lighter tile than the panel itself reads better.</summary>
    [Parameter] public string Background { get; set; } = "#1F5F8B";
}
