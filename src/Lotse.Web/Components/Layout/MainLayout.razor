@inherits LayoutComponentBase
@inject SpeechService Speech
@inject NavigationManager Nav
@inject Lotse.Infrastructure.Ai.TutorRegistry Tutors
@inject Lotse.Web.Services.LearnerProfileState ProfileState
@implements IDisposable

<MudThemeProvider Theme="_theme" @bind-IsDarkMode="_dark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<a class="skip-link" href="@(Nav.Uri.Split('#')[0] + "#main")">Zum Inhalt springen</a>
<MudLayout>
    <MudAppBar Elevation="0" Dense="true" Class="lotse-appbar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@(() => _drawerOpen = !_drawerOpen)" Class="d-md-none" aria-label="Menü" />
        <MudText Typo="Typo.h6" Class="ml-1" Style="font-weight:600; letter-spacing:.3px">Lotse</MudText>
        <MudText Typo="Typo.caption" Class="ml-2 d-none d-sm-inline" Style="opacity:.75">Dein Kurs auf @_target.Label()</MudText>
        <MudSpacer />
        <MudTooltip Text="@(_dark ? "Helles Design" : "Dunkles Design")">
            <MudIconButton Icon="@(_dark ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)" Color="Color.Inherit" OnClick="@(() => _dark = !_dark)" aria-label="Design wechseln" />
        </MudTooltip>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" Elevation="1" Variant="DrawerVariant.Responsive" Breakpoint="Breakpoint.Md" ClipMode="DrawerClipMode.Always">
        <NavMenu />
    </MudDrawer>
    <MudMainContent Class="lotse-main" id="main" tabindex="-1">
        <MudContainer MaxWidth="MaxWidth.Medium" Class="py-4 px-3 px-sm-6">
            <ErrorBoundary @ref="_errors">
                <ChildContent>
                    @* Cascaded so every feedback panel labels its contrastive note with the right language without
                       each exercise component having to load the profile itself. *@
                    <CascadingValue Value="_lang">
                        @Body
                    </CascadingValue>
                </ChildContent>
                <ErrorContent Context="ex">
                    @* Friendly recovery instead of the yellow bar: the circuit stays alive, the learner keeps their session. *@
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-2">
                        <MudText Typo="Typo.subtitle1" Style="font-weight:600">Das hat gerade nicht geklappt.</MudText>
                        <MudText Typo="Typo.body2" Class="mb-2">Dein Lernstand ist gespeichert. Versuch es noch einmal – wenn es wieder passiert, hilft „Reparieren“ in den Einstellungen.</MudText>
                        <MudText Typo="Typo.caption" Class="mono d-block mb-2" Style="opacity:.7">@ex.GetType().Name: @ex.Message</MudText>
                        <MudStack Row="true" Spacing="2">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Recover">Noch einmal</MudButton>
                            <MudButton Variant="Variant.Text" Href="einstellungen">Einstellungen</MudButton>
                        </MudStack>
                    </MudAlert>
                </ErrorContent>
            </ErrorBoundary>
        </MudContainer>
    </MudMainContent>
    <BottomNav />
</MudLayout>

@code {
    [Inject] private IBrowserViewportService Viewport { get; set; } = default!;

    private bool _drawerOpen;
    private bool _dark;
    private ErrorBoundary? _errors;
    private TargetLevel _target = TargetLevel.B2;
    private HelperLanguage _lang = HelperLanguage.Serbian;

    protected override async Task OnInitializedAsync()
    {
        // A navigation clears a previous error so the next page renders normally.
        Nav.LocationChanged += (_, _) => { _errors?.Recover(); };
        // This learner's tutor settings (incl. the decrypted API key) are loaded BEFORE the first render of any page
        // in this layout, so no page ever sees the registry's defaults - that is the one place the per-circuit
        // cache gets filled. Every route on this layout sits behind the login (fallback policy + [Authorize]);
        // the static pages (Account/*, /Error, /not-found) use AccountLayout and never get here.
        // TutorRegistry.EnsureCurrentAsync remains as a cheap guard on every provider call: defence in depth,
        // not the mechanism.
        await Tutors.InitializeAsync();
        // The bar says what the learner is working towards. The layout is built once per circuit, so it also has to
        // listen: saving on Einstellungen must move the label without a full reload.
        ProfileState.Changed += OnProfileChanged;
        Apply(await ProfileState.GetAsync());
    }

    private void OnProfileChanged() => _ = InvokeAsync(async () =>
    {
        Apply(await ProfileState.GetAsync());
        StateHasChanged();
    });

    private void Apply(LearnerProfile p)
    {
        _target = p.TargetLevel;
        _lang = p.HelperLanguage;
    }

    public void Dispose() => ProfileState.Changed -= OnProfileChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var bp = await Viewport.GetCurrentBreakpointAsync();
        _drawerOpen = bp >= Breakpoint.Md;
        // Follow the operating system's dark mode on first load; the toggle in the bar overrides it.
        try { _dark = await Speech.PrefersDarkAsync(); } catch (JSException) { }
        StateHasChanged();
    }

    private void Recover()
    {
        _errors?.Recover();
        Nav.NavigateTo(Nav.Uri, forceLoad: false);
    }

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#1F5F8B",
            Secondary = "#E07A1F",
            // White on this orange is 3.0:1 - below AA for the button-sized text it carries. Dark ink reads.
            SecondaryContrastText = "#1B2733",
            Tertiary = "#2E8B57",
            AppbarBackground = "#1F5F8B",
            Background = "#F6F7F9",
            Surface = "#FFFFFF",
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#6FB1E0",
            Secondary = "#F2A65A",
            Tertiary = "#5CC08A",
            // The dark accents are light by design, and MudBlazor keeps white text on them: 2.3:1 on the primary
            // buttons ("Fokus-Session", "10 Minuten starten"). The account pages made the right call already
            // (--acct-btn-text: #0F1A24); the theme now matches them.
            PrimaryContrastText = "#0F1A24",
            SecondaryContrastText = "#0F1A24",
            TertiaryContrastText = "#0F1A24",
            AppbarBackground = "#16324A",
            Background = "#111820",
            Surface = "#1A2430",
            DrawerBackground = "#16202B",
        },
        LayoutProperties = new LayoutProperties { DefaultBorderRadius = "10px", DrawerWidthLeft = "230px" },
        Typography = new Typography { Default = new DefaultTypography { FontFamily = ["Roboto", "Segoe UI", "Helvetica", "Arial", "sans-serif"] } },
    };
}
