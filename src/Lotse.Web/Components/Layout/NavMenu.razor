@inject NavigationManager Nav

<AuthorizeView>
    <Authorized>
        <div class="nav-account">
            <div class="nav-account-email" title="@context.User.Identity?.Name">@context.User.Identity?.Name</div>
            <form action="Account/Logout" method="post">
                <AntiforgeryToken />
                <input type="hidden" name="ReturnUrl" value="@Nav.ToBaseRelativePath(Nav.Uri)" />
                <button type="submit" class="nav-account-logout" title="Abmelden">
                    <MudIcon Icon="@Icons.Material.Filled.Logout" Size="Size.Small" />
                    <span>Abmelden</span>
                </button>
            </form>
        </div>
        <MudDivider Class="mb-2" />
    </Authorized>
</AuthorizeView>

<MudNavMenu Bordered="false" Rounded="true" Margin="Margin.Dense" Class="pa-2">
    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Today">Heute</MudNavLink>
    <MudNavLink Href="kurs" Icon="@Icons.Material.Filled.MenuBook">Kurs</MudNavLink>
    <MudNavLink Href="schreiben" Icon="@Icons.Material.Filled.Edit">Schreiben</MudNavLink>
    <MudNavLink Href="sprechen" Icon="@Icons.Material.Filled.Mic">Sprechen</MudNavLink>
    <MudNavLink Href="pruefung" Icon="@Icons.Material.Filled.School">Prüfung B2</MudNavLink>
    <MudDivider Class="my-2" />
    <MudNavLink Href="fortschritt" Icon="@Icons.Material.Filled.Insights">Fortschritt</MudNavLink>
    <MudNavLink Href="fehler" Icon="@Icons.Material.Filled.BugReport">Fehlerjournal</MudNavLink>
    <MudNavLink Href="themen" Icon="@Icons.Material.Filled.AccountTree">Themen</MudNavLink>
    <MudDivider Class="my-2" />
    <MudNavLink Href="einstellungen" Icon="@Icons.Material.Filled.Settings">Einstellungen</MudNavLink>
</MudNavMenu>
