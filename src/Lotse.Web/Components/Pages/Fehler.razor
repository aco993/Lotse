@page "/fehler"
@inject ILearningService Learning

<PageTitle>Fehlerjournal – Lotse</PageTitle>

<MudText Typo="Typo.h5" HtmlTag="h1" Class="mb-1">Fehlerjournal</MudText>
<MudText Typo="Typo.body2" Class="mb-3" Style="opacity:.8">Jeder Fehler – aus Übungen wie aus Tutor-Bewertungen – landet hier mit Code. Die Häufungen steuern, was der Lotse dir als Nächstes vorlegt.</MudText>

@if (_entries is null) { <MudSkeleton Height="200px" /> }
else if (_entries.Count == 0) { <MudAlert Severity="Severity.Success" Variant="Variant.Text">Noch keine Fehler protokolliert. Das ändert sich – und das ist gut so.</MudAlert> }
else
{
    <MudPaper Class="pa-3 mb-3" Elevation="1">
        <MudText Typo="Typo.subtitle2" Class="mb-1">Nach Fehlertyp (30 Tage)</MudText>
        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
            @foreach (var g in _entries.GroupBy(e => e.Code).OrderByDescending(g => g.Count()).Take(14))
            {
                var code = g.Key;
                <MudChip T="string" Variant="@(_filter == code ? Variant.Filled : Variant.Outlined)" Color="@SeverityColor(g.First().Severity)" OnClick="() => _filter = _filter == code ? null : code">@g.First().Title · @g.Count()</MudChip>
            }
        </MudStack>
    </MudPaper>

    <MudSimpleTable Dense="true" Hover="true" Elevation="1">
        <thead><tr><th>Wann</th><th>Fehler</th><th>Thema</th><th>Deine Form → richtig</th><th></th></tr></thead>
        <tbody>
        @foreach (var e in _entries.Where(e => _filter is null || e.Code == _filter).Take(150))
        {
            <tr>
                <td style="white-space:nowrap">@e.Utc.ToLocalTime().ToString("dd.MM. HH:mm")</td>
                <td><MudTooltip Text="@e.Code"><span>@e.Title</span></MudTooltip></td>
                <td style="opacity:.8">@e.NodeTitle</td>
                <td>@if (!string.IsNullOrWhiteSpace(e.Snippet)) { <s style="opacity:.7">@Trim(e.Snippet)</s> <span> → </span> } <b>@Trim(e.Correction)</b></td>
                <td>@if (e.FromAi) { <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Small" Title="vom Tutor erkannt" /> }</td>
            </tr>
        }
        </tbody>
    </MudSimpleTable>
}

@code {
    private IReadOnlyList<ErrorJournalEntry>? _entries;
    private string? _filter;

    protected override async Task OnInitializedAsync() => _entries = await Learning.GetErrorJournalAsync(days: 30, take: 400);

    private static string Trim(string? s) => s is null ? "" : s.Length > 70 ? s[..70] + "…" : s;
    private static Color SeverityColor(int sev) => sev >= 3 ? Color.Error : sev == 2 ? Color.Warning : Color.Default;
}
