@page "/fortschritt"
@inject ILearningService Learning
@inject ContentCatalogProvider CatalogProvider

<PageTitle>Fortschritt – Lotse</PageTitle>

<MudText Typo="Typo.h5" HtmlTag="h1" Class="mb-3">Fortschritt</MudText>

@if (_states is null) { <MudSkeleton Height="200px" /> }
else
{
    @* Three honest numbers straight from the FSRS state - what sticks, what is coming, how much is still in reach. *@
    <MudGrid Spacing="2" Class="mb-4">
        <MudItem xs="12" sm="4">
            <MudPaper Class="pa-4" Elevation="1" Style="height:100%">
                <MudText Typo="Typo.h4" Style="font-weight:600">@(_stats?.Stuck ?? 0)</MudText>
                <MudText Typo="Typo.subtitle2">Wörter, die sitzen</MudText>
                <MudText Typo="Typo.caption" Style="opacity:.75">
                    Erinnerung hält länger als @ProgressStatsCalculator.StuckDays.ToString("0") Tage@(_stats is { StuckReviewedThisWeek: > 0 } s ? $" · {s.StuckReviewedThisWeek} davon diese Woche wiederholt" : "").
                </MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudPaper Class="pa-4" Elevation="1" Style="height:100%">
                <MudText Typo="Typo.subtitle2" Class="mb-1">Fällig in den nächsten 7 Tagen</MudText>
                @if (_stats is null || _stats.DueNext7Days.Count == 0) { <MudText Typo="Typo.body2" Style="opacity:.7">Noch nichts geplant.</MudText> }
                else
                {
                    <div style="display:flex; align-items:flex-end; gap:6px; height:70px">
                        @{ var maxDue = Math.Max(1, _stats.DueNext7Days.Max(d => d.Count)); }
                        @foreach (var d in _stats.DueNext7Days)
                        {
                            var h = d.Count == 0 ? 2 : Math.Max(6, 62.0 * d.Count / maxDue);
                            <MudTooltip Text="@($"{d.Day:dd.MM.}: {d.Count} fällig")">
                                <div style="@($"width:20px;height:{h:F0}px;background:{(d.Count == 0 ? "var(--mud-palette-lines-default)" : "var(--mud-palette-primary)")};border-radius:3px")"></div>
                            </MudTooltip>
                        }
                    </div>
                    <MudText Typo="Typo.caption" Style="opacity:.75">Heute enthält alles Überfällige. Gesamt: @_stats.DueNext7Days.Sum(d => d.Count).</MudText>
                }
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudPaper Class="pa-4" Elevation="1" Style="height:100%">
                <MudText Typo="Typo.h4" Style="font-weight:600">@((_stats?.AverageRetrievability ?? 0).ToString("P0"))</MudText>
                <MudText Typo="Typo.subtitle2">Behalten</MudText>
                <MudText Typo="Typo.caption" Style="opacity:.75">
                    @(_stats is null || _stats.Scheduled == 0
                        ? "Noch keine geplanten Wiederholungen."
                        : $"So viel von deinen {_stats.Scheduled} geplanten Aufgaben würdest du gerade auf Anhieb können.")
                </MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudText Typo="Typo.subtitle1" Style="font-weight:600" Class="mb-1">Letzte 30 Tage</MudText>
        @if (_history.Count == 0) { <MudText Typo="Typo.body2" Style="opacity:.7">Noch keine Aufgaben bearbeitet.</MudText> }
        else
        {
            <div style="display:flex; align-items:flex-end; gap:3px; height:90px">
                @{ var max = Math.Max(1, _history.Max(h => h.Attempts)); }
                @foreach (var day in Enumerable.Range(0, 30).Select(i => DateTime.UtcNow.Date.AddDays(-29 + i)))
                {
                    var h = _history.FirstOrDefault(x => x.Day == day);
                    var height = h == default ? 2 : Math.Max(4, 86.0 * h.Attempts / max);
                    var color = h == default ? "var(--mud-palette-lines-default)" : h.Accuracy >= 0.8 ? "var(--mud-palette-tertiary)" : h.Accuracy >= 0.6 ? "var(--mud-palette-primary)" : "var(--mud-palette-secondary)";
                    <MudTooltip Text="@(h == default ? day.ToString("dd.MM.") : $"{day:dd.MM.}: {h.Attempts} Aufgaben, {h.Accuracy:P0} richtig")">
                        <div style="@($"width:14px;height:{height:F0}px;background:{color};border-radius:3px")"></div>
                    </MudTooltip>
                }
            </div>
            <MudText Typo="Typo.caption" Style="opacity:.6">Balkenhöhe = Aufgaben pro Tag, Farbe = Trefferquote (grün ≥ 80 %, blau ≥ 60 %).</MudText>
        }
    </MudPaper>

    @foreach (var area in Enum.GetValues<SkillArea>())
    {
        var nodes = CatalogProvider.Catalog.Nodes.Where(n => n.Area == area).OrderBy(n => n.Band).ThenBy(n => n.Title).ToList();
        if (nodes.Count == 0) continue;
        @* What already sits does not need a bar each: it is folded away so the page is about what still needs work. *@
        var strong = nodes.Where(n => _states.GetValueOrDefault(n.Id)?.IsStrong == true).ToList();
        var rest = nodes.Except(strong).ToList();
        <MudPaper Class="pa-4 mb-3" Elevation="1">
            <MudText Typo="Typo.subtitle1" Style="font-weight:600" Class="mb-2">@AreaLabel(area)</MudText>
            @if (strong.Count > 0)
            {
                <MudExpansionPanels Elevation="0" Class="mb-2">
                    <MudExpansionPanel Text="@($"Sitzt ({strong.Count})")">
                        @foreach (var n in strong)
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-1">
                                <MudText Typo="Typo.body2" Style="width:min(52%, 320px)">@n.Title <span style="opacity:.5">@n.Band.Label()</span></MudText>
                                <div style="flex:1"><MasteryBar Value="@(_states.GetValueOrDefault(n.Id)!.Mastery)" Confidence="@(_states.GetValueOrDefault(n.Id)!.Confidence)" /></div>
                                <MudText Typo="Typo.caption" Style="width:110px;text-align:right">@($"{_states.GetValueOrDefault(n.Id)!.Mastery:P0} · {_states.GetValueOrDefault(n.Id)!.Attempts}×")</MudText>
                                <MudIcon Icon="@Icons.Material.Filled.Verified" Size="Size.Small" Color="Color.Tertiary" />
                            </MudStack>
                        }
                    </MudExpansionPanel>
                </MudExpansionPanels>
            }
            @foreach (var n in rest)
            {
                var s = _states.GetValueOrDefault(n.Id);
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-1">
                    <MudText Typo="Typo.body2" Style="width:min(52%, 320px)">@n.Title <span style="opacity:.5">@n.Band.Label()</span></MudText>
                    <div style="flex:1"><MasteryBar Value="@(s?.Mastery ?? 0.5)" Confidence="@(s?.Confidence ?? 0)" /></div>
                    <MudText Typo="Typo.caption" Style="width:110px;text-align:right">
                        @if (s is null || s.Attempts == 0) { <span style="opacity:.5">noch nicht geübt</span> }
                        else { @($"{s.Mastery:P0} · {s.Attempts}×") }
                    </MudText>
                    @if (s?.RecheckDueUtc is not null) { <MudTooltip Text="@($"Wiedervorlage am {s.RecheckDueUtc:dd.MM.}")"><MudIcon Icon="@Icons.Material.Filled.EventRepeat" Size="Size.Small" Color="Color.Warning" /></MudTooltip> }
                    else if (s?.IsStrong == true) { <MudIcon Icon="@Icons.Material.Filled.Verified" Size="Size.Small" Color="Color.Tertiary" /> }
                    else { <span style="width:20px;display:inline-block"></span> }
                </MudStack>
            }
        </MudPaper>
    }
}

@code {
    private IReadOnlyDictionary<string, SkillState>? _states;
    private IReadOnlyList<(DateTime Day, int Attempts, double Accuracy)> _history = [];
    private ProgressStats? _stats;

    protected override async Task OnInitializedAsync()
    {
        _states = await Learning.GetSkillStatesAsync();
        _history = await Learning.GetDailyHistoryAsync();
        _stats = await Learning.GetProgressStatsAsync();
    }

    private static string AreaLabel(SkillArea a) => a switch
    {
        SkillArea.Grammatik => "Grammatik",
        SkillArea.Wortschatz => "Wortschatz",
        SkillArea.Redemittel => "Redemittel",
        SkillArea.Lesen => "Lesen",
        SkillArea.Hoeren => "Hören",
        SkillArea.Schreiben => "Schreiben",
        SkillArea.Sprechen => "Sprechen",
        _ => a.ToString(),
    };
}
