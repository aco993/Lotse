@page "/themen"
@inject ILearningService Learning
@inject ContentCatalogProvider CatalogProvider
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Themen – Lotse</PageTitle>

<div class="page-intro intro-themen">
    <div class="page-intro-icon"><MudIcon Icon="@Icons.Material.Filled.Map" /></div>
    <div>
        <MudText Typo="Typo.h5">Themen</MudText>
        <MudText Typo="Typo.body2" Style="opacity:.85">Normalerweise entscheidet der Lotse. Wenn du ein Thema gezielt willst – etwa vor einem Meeting –, starte hier eine Fokus-Session. Mit Tutor kannst du die Übungsbank zu einem Thema erweitern lassen.</MudText>
        <MudText Typo="Typo.caption" Style="opacity:.75">
            @(_target == TargetLevel.C1
                ? "Zielniveau C1: Schwerpunkte dürfen bis C1 reichen – die C1-Themen unten kommen von selbst dran."
                : "Zielniveau B2: Schwerpunkte bleiben bei B2.2 und darunter. C1-Themen stehen hier, werden aber nicht automatisch vorgeschlagen.")
            Ändern in <MudLink Href="einstellungen">Einstellungen</MudLink>.
        </MudText>
    </div>
</div>
@* The legend doubles as a filter: one tap narrows the list to that area, a second tap clears it. *@
<div class="task-legend" role="group" aria-label="Nach Bereich filtern">
    @foreach (var area in Enum.GetValues<SkillArea>())
    {
        var a = area;
        <button type="button" class="@AreaClass(a)" aria-pressed="@(_area == a ? "true" : "false")" @onclick="() => _area = _area == a ? null : a">@AreaLabel(a)</button>
    }
</div>

@if (Learning.Tutor.IsAvailable)
{
    <MudPaper Class="pa-3 mb-3 mt-2" Elevation="1" Style="border:1px solid var(--mud-palette-primary)">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
            <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Color="Color.Primary" />
            <MudText Typo="Typo.body2">Übungsbank auffüllen: je 6 neue Aufgaben für deine 3 schwächsten Themen, zugeschnitten auf deine letzten Fehler.</MudText>
            <MudSpacer />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="FillWeakestAsync" Disabled="_filling">@(_filling ? "Erzeuge …" : "Auffüllen")</MudButton>
        </MudStack>
        @if (_fillResult is not null) { <MudText Typo="Typo.caption" Class="mt-1 d-block">@_fillResult</MudText> }
    </MudPaper>
}

<MudTextField @bind-Value="_search" Placeholder="Thema suchen …" Variant="Variant.Outlined" Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="mb-2 mt-2" />

@foreach (var group in CatalogProvider.Catalog.Nodes.Where(Matches).OrderBy(n => n.Area).ThenBy(n => n.Band).GroupBy(n => n.Area))
{
    <div class="area-head @AreaClass(group.Key)"><span>@AreaLabel(group.Key)</span><small>@group.Count() @(group.Count() == 1 ? "Thema" : "Themen")</small></div>
    @foreach (var node in group)
    {
        var n = node;
        var drills = CatalogProvider.Catalog.ForNode(n.Id).Count(); // every task type counts - a writing node has writing tasks, not drills
        var s = _states?.GetValueOrDefault(n.Id);
        <MudPaper @key="n.Id" Class="@($"task-card task-static topic-card pa-3 mb-2 {AreaClass(n.Area)}")" Elevation="1">
            <div class="task-row">
                <div class="task-icon"><MudIcon Icon="@AreaIcon(n.Area)" Size="Size.Small" /></div>
                <div class="task-body">
                    <div class="task-meta">
                        <span class="topic-title">@n.Title</span>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="task-chip">@n.Band.Label()</MudChip>
                        @if (n.SerbianInterference) { <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary" Class="task-chip" Icon="@Icons.Material.Filled.SwapHoriz">@_lang.ShortTag()-Interferenz</MudChip> }
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="task-chip" Icon="@Icons.Material.Outlined.FitnessCenter">@drills Übungen</MudChip>
                        @if (s is not null && s.Attempts > 0)
                        {
                            <span class="task-node topic-mastery">
                                <span class="heat topic-heat"><span style="@($"width:{(int)Math.Round(s.Mastery * 100)}%")"></span></span>
                                @s.Mastery.ToString("P0") · @s.Attempts×
                            </span>
                        }
                    </div>
                    <MudText Typo="Typo.body2" Class="task-prompt" Style="opacity:.85">@n.Description</MudText>
                    @if (n.InterferenceNoteFor(_lang) is { } note)
                    {
                        <div class="ex-serbian mt-2"><MudText Typo="Typo.body2">@note</MudText></div>
                    }
                    <MudStack Row="true" Spacing="1" Class="mt-2" Wrap="Wrap.Wrap">
                        @if (drills > 0)
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="() => FocusAsync(n.Id)">Fokus-Session (10 min)</MudButton>
                        }
                        @if (Learning.Tutor.IsAvailable && n.Area is SkillArea.Grammatik or SkillArea.Wortschatz or SkillArea.Redemittel)
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.AutoAwesome" OnClick="() => GenerateAsync(n.Id)" Disabled="_generating == n.Id">@(_generating == n.Id ? "Erzeuge …" : "6 neue Übungen erzeugen")</MudButton>
                        }
                        @if (Learning.Tutor.IsAvailable && n.Area is SkillArea.Lesen or SkillArea.Hoeren)
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.AutoAwesome" OnClick="() => GenerateReadingAsync(n.Id)" Disabled="_generating == n.Id">@(_generating == n.Id ? "Erzeuge …" : (n.Area == SkillArea.Lesen ? "Neuen Lesetext erzeugen" : "Neue Höraufgabe erzeugen"))</MudButton>
                        }
                        @if (CatalogProvider.Catalog.ForNode(n.Id).Any(e => e.Type == ExerciseType.Reading))
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => StartReadingAsync(n.Id)">@(n.Area == SkillArea.Hoeren ? "Höraufgabe üben" : "Lesetext üben")</MudButton>
                        }
                    </MudStack>
                </div>
            </div>
        </MudPaper>
    }
}

@code {
    private string _search = "";
    private string? _generating;
    private IReadOnlyDictionary<string, SkillState>? _states;
    private TargetLevel _target = TargetLevel.B2;
    private HelperLanguage _lang = HelperLanguage.Serbian;

    protected override async Task OnInitializedAsync()
    {
        _states = await Learning.GetSkillStatesAsync();
        var profile = await Learning.GetProfileAsync();
        _target = profile.TargetLevel;
        _lang = profile.HelperLanguage;
    }

    private SkillArea? _area;

    private bool Matches(SkillNode n) => (_area is null || n.Area == _area)
        && (string.IsNullOrWhiteSpace(_search)
            || n.Title.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || n.Description.Contains(_search, StringComparison.OrdinalIgnoreCase));

    // One hue per skill area, used for the stripe, icon tile, section header and legend (see .area-* in app.css).
    private static string AreaClass(SkillArea a) => a switch
    {
        SkillArea.Grammatik => "area-grammatik",
        SkillArea.Wortschatz => "area-wortschatz",
        SkillArea.Redemittel => "area-redemittel",
        SkillArea.Lesen => "area-lesen",
        SkillArea.Hoeren => "area-hoeren",
        SkillArea.Schreiben => "area-schreiben",
        _ => "area-sprechen",
    };

    private static string AreaLabel(SkillArea a) => a switch
    {
        SkillArea.Hoeren => "Hören",
        _ => a.ToString(),
    };

    private static string AreaIcon(SkillArea a) => a switch
    {
        SkillArea.Grammatik => Icons.Material.Filled.Spellcheck,
        SkillArea.Wortschatz => Icons.Material.Filled.Translate,
        SkillArea.Redemittel => Icons.Material.Filled.Chat,
        SkillArea.Lesen => Icons.Material.Filled.MenuBook,
        SkillArea.Hoeren => Icons.Material.Filled.Headphones,
        SkillArea.Schreiben => Icons.Material.Filled.Edit,
        _ => Icons.Material.Filled.Mic,
    };

    private async Task FocusAsync(string nodeId)
    {
        var s = await Learning.StartSessionAsync(10, nodeId);
        Nav.NavigateTo($"session/{s.Id}");
    }

    private bool _filling;
    private string? _fillResult;

    private async Task FillWeakestAsync()
    {
        _filling = true;
        try
        {
            var result = await Learning.FillWeakestAsync();
            _fillResult = result.Count == 0 ? "Keine schwachen Themen mit Daten gefunden – erst ein paar Sessions machen." : string.Join(" · ", result.Select(r => $"{r.NodeTitle}: {r.Count}"));
        }
        catch (Exception e) { _fillResult = "Fehler: " + TutorRegistry.Friendly(e); }
        finally { _filling = false; }
    }

    private async Task StartReadingAsync(string nodeId)
    {
        var pool = CatalogProvider.Catalog.ForNode(nodeId).Where(e => e.Type == ExerciseType.Reading).ToList();
        if (pool.Count == 0) return;
        var ex = pool[Random.Shared.Next(pool.Count)];
        var s = await Learning.StartSingleAsync(ex.Id, SessionKind.Free);
        Nav.NavigateTo($"session/{s.Id}");
    }

    private async Task GenerateReadingAsync(string nodeId)
    {
        _generating = nodeId;
        try
        {
            var ex = await Learning.GenerateReadingForNodeAsync(nodeId);
            Snackbar.Add(ex is null ? "Keine gültige Aufgabe erhalten." : "Neue Aufgabe in der Bank: " + ex.Prompt, ex is null ? Severity.Warning : Severity.Success);
        }
        catch (Exception e) { Snackbar.Add("Generierung fehlgeschlagen: " + TutorRegistry.Friendly(e), Severity.Error); }
        finally { _generating = null; }
    }

    private async Task GenerateAsync(string nodeId)
    {
        _generating = nodeId;
        try
        {
            var made = await Learning.GenerateForNodeAsync(nodeId);
            Snackbar.Add(made.Count == 0 ? "Keine gültigen Übungen erhalten." : $"{made.Count} neue Übungen in der Bank.", made.Count == 0 ? Severity.Warning : Severity.Success);
        }
        catch (Exception e) { Snackbar.Add("Generierung fehlgeschlagen: " + TutorRegistry.Friendly(e), Severity.Error); }
        finally { _generating = null; }
    }
}
