@* Illustrated scene for a lesson: an inline SVG per scene key, themed by colour. No image files, scales to any width.
   SVG <text> elements are emitted as markup strings because Razor reserves the <text> tag. *@
<svg viewBox="0 0 320 140" class="lesson-art" role="img" aria-label="@Scene" preserveAspectRatio="xMidYMid slice">
    <defs>
        <linearGradient id="@($"g-{Scene}")" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="@Primary" />
            <stop offset="1" stop-color="@Secondary" />
        </linearGradient>
    </defs>
    <rect width="320" height="140" fill="@($"url(#g-{Scene})")" />
    <circle cx="270" cy="30" r="46" fill="#fff" opacity=".08" />
    <circle cx="40" cy="120" r="70" fill="#fff" opacity=".06" />
    @switch (Scene)
    {
        case "team":
            <g fill="#fff" opacity=".95">
                <circle cx="110" cy="62" r="14" /><rect x="90" y="80" width="40" height="34" rx="12" />
                <circle cx="160" cy="58" r="16" /><rect x="138" y="78" width="44" height="38" rx="13" />
                <circle cx="212" cy="64" r="13" /><rect x="194" y="81" width="36" height="32" rx="11" />
            </g>
            <path d="M120 40 q40 -30 80 0" stroke="#fff" stroke-width="3" fill="none" opacity=".7" />
            break;
        case "email":
            <g fill="#fff" opacity=".95"><rect x="100" y="40" width="120" height="76" rx="8" /><path d="M100 48 l60 40 l60 -40" fill="none" stroke="@Primary" stroke-width="5" /></g>
            <circle cx="222" cy="44" r="12" fill="#FFD166" />
            break;
        case "meeting":
            <ellipse cx="160" cy="100" rx="90" ry="22" fill="#fff" opacity=".9" />
            <g fill="#fff"><circle cx="110" cy="60" r="12" /><circle cx="160" cy="52" r="13" /><circle cx="210" cy="60" r="12" /><circle cx="135" cy="72" r="10" /><circle cx="185" cy="72" r="10" /></g>
            <rect x="60" y="24" width="60" height="36" rx="4" fill="#fff" opacity=".6" />
            break;
        case "customer":
            <g fill="#fff" opacity=".95"><rect x="70" y="50" width="110" height="60" rx="12" /><path d="M90 110 l10 18 l16 -18" /></g>
            <g fill="#fff" opacity=".75"><rect x="190" y="70" width="70" height="40" rx="10" /><path d="M245 110 l-8 14 l-12 -14" /></g>
            @Label(85, 88, 26, Primary, "!?")
            break;
        case "office":
            <g fill="#fff" opacity=".95"><rect x="80" y="30" width="160" height="90" rx="6" /><rect x="95" y="45" width="130" height="10" rx="3" fill="@Primary" opacity=".5" /><rect x="95" y="63" width="90" height="8" rx="3" fill="@Primary" opacity=".35" /><rect x="95" y="79" width="110" height="8" rx="3" fill="@Primary" opacity=".35" /><rect x="95" y="95" width="60" height="8" rx="3" fill="@Primary" opacity=".35" /></g>
            <circle cx="232" cy="38" r="14" fill="#FFD166" />
            @Label(224, 44, 15, "#333", "47")
            break;
        case "home":
            <path d="M160 30 l70 55 h-20 v45 h-100 v-45 h-20 z" fill="#fff" opacity=".95" />
            <rect x="145" y="95" width="30" height="35" fill="@Primary" opacity=".6" /><rect x="112" y="92" width="20" height="18" fill="#FFD166" />
            <g stroke="#fff" stroke-width="3" opacity=".7" fill="none"><path d="M260 60 q10 -10 20 0 q-10 10 -20 0" /><path d="M250 80 q8 -8 16 0" /></g>
            break;
        case "doctor":
            <rect x="120" y="40" width="80" height="80" rx="10" fill="#fff" opacity=".95" />
            <rect x="150" y="55" width="20" height="50" fill="#C44536" /><rect x="135" y="70" width="50" height="20" fill="#C44536" />
            <circle cx="240" cy="70" r="16" fill="#fff" opacity=".7" /><path d="M240 60 v10 h8" stroke="@Primary" stroke-width="3" fill="none" />
            break;
        case "server":
            <g fill="#fff" opacity=".95"><rect x="110" y="30" width="100" height="24" rx="4" /><rect x="110" y="60" width="100" height="24" rx="4" /><rect x="110" y="90" width="100" height="24" rx="4" /></g>
            <g><circle cx="125" cy="42" r="4" fill="#5CC08A" /><circle cx="125" cy="72" r="4" fill="#5CC08A" /><circle cx="125" cy="102" r="4" fill="#C44536" /></g>
            @Label(230, 80, 30, "#fff", "⚠")
            break;
        case "debate":
            <g fill="#fff" opacity=".95"><rect x="60" y="40" width="90" height="50" rx="12" /><path d="M80 90 l6 14 l14 -14" /></g>
            <g fill="#fff" opacity=".75"><rect x="170" y="55" width="90" height="50" rx="12" /><path d="M240 105 l-6 14 l-14 -14" /></g>
            @Label(82, 72, 18, Primary, "pro")
            @Label(188, 87, 18, Primary, "contra")
            break;
        case "weekend":
            <circle cx="250" cy="40" r="22" fill="#FFD166" />
            <path d="M0 110 q80 -30 160 0 t160 0 v30 h-320 z" fill="#fff" opacity=".85" />
            <g fill="@Primary" opacity=".6"><rect x="120" y="70" width="6" height="40" /><path d="M123 70 l-25 25 h50 z" /></g>
            <circle cx="85" cy="95" r="9" fill="#fff" /><circle cx="105" cy="97" r="8" fill="#fff" />
            break;
        case "salary":
            <g fill="#fff" opacity=".95"><rect x="90" y="50" width="140" height="70" rx="8" /></g>
            <polyline points="105,105 130,90 155,95 180,70 215,62" fill="none" stroke="#2E8B57" stroke-width="4" />
            @Label(200, 45, 26, "#fff", "+8 %")
            break;
        case "exam":
            <g fill="#fff" opacity=".95"><rect x="110" y="30" width="100" height="90" rx="6" /></g>
            <g stroke="@Primary" stroke-width="3" opacity=".5"><path d="M125 50 h70" /><path d="M125 65 h70" /><path d="M125 80 h50" /></g>
            <path d="M130 98 l8 8 l16 -16" stroke="#2E8B57" stroke-width="5" fill="none" />
            @Label(225, 60, 22, "#fff", "B2")
            break;
        default:
            <circle cx="160" cy="70" r="30" fill="#fff" opacity=".9" />
            break;
    }
</svg>

@code {
    [Parameter] public string Scene { get; set; } = "team";
    [Parameter] public ExerciseContext Theme { get; set; } = ExerciseContext.Beruf;

    private string Primary => Theme switch { ExerciseContext.Beruf => "#1F5F8B", ExerciseContext.Alltag => "#2E8B57", _ => "#6A4C93" };
    private string Secondary => Theme switch { ExerciseContext.Beruf => "#3E8FC4", ExerciseContext.Alltag => "#5CC08A", _ => "#9B7BC7" };

    private static MarkupString Label(int x, int y, int size, string fill, string content)
        => new($"<text x=\"{x}\" y=\"{y}\" font-size=\"{size}\" font-weight=\"700\" fill=\"{fill}\" opacity=\".9\">{System.Net.WebUtility.HtmlEncode(content)}</text>");
}
