@* Recently submitted texts / recordings. Same card language as TaskList, but the accent here is the result:
   green from 60 % (the exam's pass line), orange below, neutral when it was only a self-check without a score. *@
@inject ILearningService Learning
@inject ContentCatalogProvider CatalogProvider

@if (_items is null) { <MudSkeleton Height="80px" /> }
else if (_items.Count == 0) { <MudText Typo="Typo.body2" Style="opacity:.7">Noch nichts eingereicht.</MudText> }
else
{
    <MudStack Spacing="2">
        @foreach (var p in _items)
        {
            <MudPaper @key="p.Id" Class="@($"task-card task-static pa-3 {ScoreClass(p)}")" Elevation="1">
                <div class="task-row">
                    <div class="task-icon"><MudIcon Icon="@(p.IsSpeaking ? Icons.Material.Filled.Mic : Icons.Material.Filled.Edit)" Size="Size.Small" /></div>
                    <div class="task-body">
                        <div class="task-meta">
                            @if (p.Score is { } s) { <span class="task-ctx">@s.ToString("P0")</span> }
                            else { <span class="task-ctx">Selbstcheck</span> }
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="task-chip" Icon="@Icons.Material.Outlined.Notes">@p.WordCount Wörter</MudChip>
                            @if (p.EstimatedLevel is not null) { <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="task-chip">@p.EstimatedLevel</MudChip> }
                            @if (p.EvaluatedByAi) { <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="task-chip" Icon="@Icons.Material.Filled.AutoAwesome">Tutor</MudChip> }
                            <span class="task-node">@p.Utc.ToLocalTime().ToString("dd.MM.yyyy HH:mm") · @CatalogProvider.Catalog.NodeTitle(p.NodeId)</span>
                        </div>
                        <MudText Typo="Typo.body2" Class="task-prompt" Style="opacity:.85">@(CatalogProvider.Catalog.Exercise(p.ExerciseId)?.Prompt)</MudText>
                        <MudExpansionPanels Elevation="0" Dense="true" Class="mt-1">
                            <MudExpansionPanel Text="Text anzeigen"><MudText Class="preline" Typo="Typo.body2">@p.Text</MudText></MudExpansionPanel>
                        </MudExpansionPanels>
                    </div>
                </div>
            </MudPaper>
        }
    </MudStack>
}

@code {
    [Parameter] public bool Speaking { get; set; }
    private IReadOnlyList<ProductionEntity>? _items;
    protected override async Task OnInitializedAsync()
        => _items = (await Learning.RecentProductionsAsync(40)).Where(p => p.IsSpeaking == Speaking).ToList();

    private static string ScoreClass(ProductionEntity p) => p.Score switch
    {
        null => "score-none",
        >= 0.6 => "score-good",
        _ => "score-weak",
    };
}
