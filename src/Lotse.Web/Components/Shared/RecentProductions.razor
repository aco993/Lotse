@inject LearningService Learning
@inject ContentCatalogProvider CatalogProvider

@if (_items is null) { <MudSkeleton Height="80px" /> }
else if (_items.Count == 0) { <MudText Typo="Typo.body2" Style="opacity:.7">Noch nichts eingereicht.</MudText> }
else
{
    <MudStack Spacing="2">
        @foreach (var p in _items)
        {
            <MudPaper Class="pa-3" Elevation="1">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Wrap="Wrap.Wrap">
                    <MudText Typo="Typo.caption">@p.Utc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudText>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@p.WordCount Wörter</MudChip>
                    @if (p.Score is { } s) { <MudChip T="string" Size="Size.Small" Color="@(s >= 0.6 ? Color.Tertiary : Color.Warning)" Variant="Variant.Filled">@s.ToString("P0")</MudChip> }
                    @if (p.EstimatedLevel is not null) { <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@p.EstimatedLevel</MudChip> }
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@(p.EvaluatedByAi ? "Tutor" : "Selbstcheck")</MudChip>
                    <MudSpacer />
                    <MudText Typo="Typo.caption" Style="opacity:.7">@CatalogProvider.Catalog.NodeTitle(p.NodeId)</MudText>
                </MudStack>
                <MudText Typo="Typo.body2" Class="mt-1" Style="opacity:.85">@(CatalogProvider.Catalog.Exercise(p.ExerciseId)?.Prompt)</MudText>
                <MudExpansionPanels Elevation="0" Dense="true" Class="mt-1">
                    <MudExpansionPanel Text="Text anzeigen"><MudText Class="preline" Typo="Typo.body2">@p.Text</MudText></MudExpansionPanel>
                </MudExpansionPanels>
            </MudPaper>
        }
    </MudStack>
}

@code {
    [Parameter] public bool Speaking { get; set; }
    private IReadOnlyList<ProductionEntity>? _items;
    protected override async Task OnInitializedAsync()
        => _items = (await Learning.RecentProductionsAsync(40)).Where(p => p.IsSpeaking == Speaking).ToList();
}
