@* Pickable list of production / reading tasks. Colour carries meaning here: the accent (left stripe, icon tile,
   context label, faint wash) is the task's context - green Alltag, blue Beruf, orange Prüfung - so a long list
   scans by situation before anyone reads a word; the icon tile says what you'll do (write / speak / read). *@
@inject ContentCatalogProvider CatalogProvider

@if (Items.Count == 0)
{
    <MudText Typo="Typo.body2" Style="opacity:.7">Keine Aufgaben in dieser Kategorie.</MudText>
}
<MudStack Spacing="2">
    @foreach (var item in Items)
    {
        @* Whole card is the control: role/tabindex/keydown make it reachable and operable from the keyboard. *@
        <MudPaper @key="item.Id" Class="@($"task-card pa-3 {ContextClass(item.Context)}")" Elevation="1"
                  role="button" tabindex="0" aria-label="@($"{ContextLabel(item.Context)}, {item.Band.Label()}: {item.Prompt}")"
                  @onclick="() => OnPick.InvokeAsync(item)" @onkeydown="e => OnKeyAsync(e, item)">
            <div class="task-row">
                <div class="task-icon"><MudIcon Icon="@IconFor(item.Type)" Size="Size.Small" /></div>
                <div class="task-body">
                    <div class="task-meta">
                        <span class="task-ctx">@ContextLabel(item.Context)</span>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="task-chip">@item.Band.Label()</MudChip>
                        @if (item.MinWords is > 0) { <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="task-chip" Icon="@Icons.Material.Outlined.Notes">~@item.MinWords Wörter</MudChip> }
                        @if (item.TargetSeconds is > 0) { <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="task-chip" Icon="@Icons.Material.Outlined.Timer">~@(item.TargetSeconds / 60) min</MudChip> }
                        <span class="task-node">@CatalogProvider.Catalog.NodeTitle(item.NodeId)</span>
                    </div>
                    <MudText Typo="Typo.body2" Class="task-prompt">@item.Prompt</MudText>
                </div>
                <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Class="task-go" />
            </div>
        </MudPaper>
    }
</MudStack>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<Exercise> Items { get; set; } = [];
    [Parameter] public EventCallback<Exercise> OnPick { get; set; }

    private Task OnKeyAsync(KeyboardEventArgs e, Exercise item)
        => e.Key is "Enter" or " " ? OnPick.InvokeAsync(item) : Task.CompletedTask;

    private static string ContextClass(ExerciseContext c) => c switch
    {
        ExerciseContext.Beruf => "ctx-beruf",
        ExerciseContext.Pruefung => "ctx-pruefung",
        _ => "ctx-alltag",
    };

    private static string ContextLabel(ExerciseContext c) => c switch
    {
        ExerciseContext.Beruf => "Beruf",
        ExerciseContext.Pruefung => "Prüfung",
        _ => "Alltag",
    };

    private static string IconFor(ExerciseType t) => t switch
    {
        ExerciseType.Speak => Icons.Material.Filled.Mic,
        ExerciseType.Reading => Icons.Material.Filled.MenuBook,
        _ => Icons.Material.Filled.Edit,
    };
}
